 # =============================================================
# BPC Clinic System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Application ---
# APP_URL may be omitted; config/config.php derives it from the current request.
# Set APP_ENV=local only for local development. Production requires a private APP_KEY.
# APP_ENV_FILE can point to a private file outside public_html when supported by the host.
APP_ENV=local
# APP_FORCE_PRODUCTION=true may be used only for an intentional local production-mode test.
# APP_URL=http://localhost/bpc_clinic_system
# Generate a unique key with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database (XAMPP defaults shown) ---
DB_HOST=localhost
DB_NAME=bpc_clinic_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_PORT=3306

# --- Hostinger production example (never put the password in source control) ---
# Confirm DB_HOST in hPanel > Databases > Management. For a PHP site and database
# on the same Hostinger hosting account it is commonly localhost.
# APP_ENV=production
# APP_URL=https://clinic.example.edu
# DB_HOST=localhost
# DB_NAME=u962995739_bpc_clinic
# DB_USER=u962995739_bpc_user
# DB_PASS=set-this-only-in-the-private-production-environment
# DB_CHARSET=utf8mb4
# DB_PORT=3306

# --- OpenRouter AI (for MICA AI Assistant) ---
# Get your free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- ElevenLabs Text-to-Speech (for MICA voice) ---
# Get your API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=kdmDKE6EkgrWrrykO9Qt

# Operator-only first administrator provisioning; use a random secret of at least 32 characters.
INITIAL_ADMIN_SETUP_TOKEN=
