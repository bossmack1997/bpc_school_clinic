<IfModule mod_rewrite.c>
    RewriteEngine On
    # Private medical attachments are served only through the authorized PHP endpoint.
    RewriteRule ^uploads/medical_records(?:/|$) - [F,L,NC]
    RewriteRule ^(?:config|database|includes|scratch|setup|storage|tests|tools|vendor)(?:/|$) - [F,L,NC]
</IfModule>

Options -Indexes

# Block hidden/private configuration and dependency manifests.
<FilesMatch "(^\.|^(?:composer\.(?:json|lock)|phpunit\.xml|package(?:-lock)?\.json)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny direct HTTP access to diagnostic, scratch and test artefacts.
# These may live in the web root during development but must never be
# served, because they can print database rows, credentials or stack
# traces to an anonymous visitor.
<FilesMatch "\.(sql|log|ini|env|bak|old|orig|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Source/database snapshots are private even when stored beside index.php.
<FilesMatch "(?i)\.(?:zip|sql\.gz|tar|tgz|7z|py|cjs)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Common debug / profiling prefixes
<FilesMatch "^(debug|test|temp|check|dump|probe|trace)[-_].*\.(php|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
