# BPC School Clinic — Hostinger production template
# Copy to a private production environment file. Never commit real values.
APP_ENV=production
APP_URL=https://bpcschoolclinic.org
APP_KEY=REPLACE_WITH_A_STABLE_RANDOM_64_HEX_CHARACTER_KEY

# Confirm DB_HOST in Hostinger hPanel > Databases > Management.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_ACTUAL_HOSTINGER_DATABASE_NAME
DB_USER=YOUR_ACTUAL_HOSTINGER_DATABASE_USERNAME
DB_PASS=YOUR_ACTUAL_HOSTINGER_DATABASE_PASSWORD
DB_CHARSET=utf8mb4

# SMTP — use the mailbox/server values shown in Hostinger Email settings.
MAIL_MAILER=smtp
MAIL_HOST=YOUR_HOSTINGER_SMTP_HOST
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS=clinic@bpcschoolclinic.org
MAIL_FROM_NAME=BPC School Clinic

# External integrations. Keep blank until configured privately.
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
FCM_SERVER_KEY=

